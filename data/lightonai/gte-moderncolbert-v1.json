  "sources": [
    {
      "title": "lightonai/GTE-ModernColBERT-v1 · Hugging Face",
      "url": "https://huggingface.co/lightonai/GTE-ModernColBERT-v1",
      "snippet": "LongEmbed Benchmark GTE-ModernColBERT has been trained with knowledge distillation on MS MARCO with a document length of 300 tokens, explaining its default value for documents length. However, as illustrated in the ModernBERT paper, ColBERT models can generalize to documents lengths way beyond their training length and GTE-ModernColBERT actually yields results way above SOTA (almost 10 points ..."
    },
    {
      "title": "GTE-ModernColBERT-v1: Text-to-Text model — overview, use cases ...",
      "url": "https://www.aimodels.fyi/models/huggingFace/gte-moderncolbert-v1-lightonai",
      "snippet": "Overview GTE-ModernColBERT-v1 is a late-interaction dense retrieval model built on top of Alibaba-NLP&#x27;s ModernBERT base model by lightonai. The model maps sentences and paragraphs to 128-dimensional dense vectors for semantic textual similarity and document retrieval using the MaxSim operator. It uses a ColBERT architecture with a Transformer layer (768 input features) reduced to 128 output ..."
    },
    {
      "title": "lightonai/GTE-ModernColBERT-v1 at main - Hugging Face",
      "url": "https://huggingface.co/lightonai/GTE-ModernColBERT-v1/tree/main",
      "snippet": "We&#x27;re on a journey to advance and democratize artificial intelligence through open source and open science."
    },
    {
      "title": "GTE-ModernColBERT-v1 by lightonai | Mixpeek Model Hub",
      "url": "https://mixpeek.com/model/lightonai/GTE-ModernColBERT-v1",
      "snippet": "GTE-ModernColBERT-v1 is a ColBERT-style late interaction retrieval model built on the ModernBERT architecture. Instead of compressing an entire document into a single vector, it produces 128-dimensional embeddings for every token, then scores query-document pairs using MaxSim: for each query token, find the best-matching document token and sum the scores. This token-level matching preserves ..."
    },
    {
      "title": "LightOn Releases GTE-ModernColBERT, First State-of-the-Art Late ...",
      "url": "https://lighton.ai/lighton-blogs/lighton-releases-gte-moderncolbert-first-state-of-the-art-late-interaction-model-trained-on-pylate",
      "snippet": "LightOn is proud to announce the release of GTE-ModernColBERT, our new state-of-the-art, open-source, multi-vector retrieval model. By leveraging ModernBERT architecture and our innovative PyLate library, we&#x27;ve created a solution that sets a new milestone in the field and addresses the complex challenges of modern enterprise information retrieval."
    }
